# Self-hosted Supabase project used by this app (browser-safe, RLS-gated).
# Copy to .env for local dev, and set the same values in Vercel → Settings → Environment Variables.
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
